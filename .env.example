# Azure Speech Studio — Pronunciation Assessment API
# Get your key at: https://speech.microsoft.com
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# LLM API — Semantic answer checking for text input questions
# Supports OpenAI-compatible APIs (OpenAI, DeepSeek, etc.)
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# DeepSeek example (default):
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
