{
  "$id": "https://ielts-claude-teacher/textbook-schema",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IELTS Textbook Test Schema",
  "description": "Schema for structured IELTS practice test data extracted from textbook Markdown. answerKeys is the single source of truth for correct answers.",
  "type": "object",
  "required": ["meta", "skills", "answerKeys"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["source", "testNumber", "version", "generatedBy", "generatedAt"],
      "properties": {
        "source": {"type": "string", "description": "e.g. Cambridge IELTS 1"},
        "testNumber": {"type": "integer"},
        "version": {"type": "string"},
        "generatedBy": {"type": "string", "description": "Skill that generated this JSON"},
        "generatedAt": {"type": "string", "format": "date-time"}
      }
    },
    "skills": {
      "type": "object",
      "properties": {
        "reading": {
          "type": "object",
          "required": ["passages"],
          "properties": {
            "passages": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "title", "text", "questionGroups"],
                "properties": {
                  "id": {"type": "string"},
                  "title": {"type": "string"},
                  "text": {"type": "string"},
                  "images": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["id", "src"],
                      "properties": {
                        "id": {"type": "string"},
                        "src": {"type": "string", "description": "Relative path from textbook source directory"},
                        "alt": {"type": "string"}
                      }
                    }
                  },
                  "questionGroups": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["id", "heading", "instructions", "questionType", "questions"],
                      "properties": {
                        "id": {"type": "string"},
                        "heading": {"type": "string"},
                        "instructions": {"type": "string"},
                        "questionType": {
                          "type": "string",
                          "enum": ["multiple-choice", "multiple-choice-image", "true-false-not-given",
                            "yes-no-not-given", "short-answer", "gap-fill", "form-completion",
                            "table-completion", "note-completion", "sentence-completion",
                            "summary-completion", "matching-headings", "diagram-labeling", "matching"]
                        },
                        "questions": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": ["number", "text", "type"],
                            "properties": {
                              "number": {"type": "integer"},
                              "text": {"type": "string"},
                              "type": {"type": "string"},
                              "options": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "required": ["label"],
                                  "properties": {
                                    "label": {"type": "string"},
                                    "text": {"type": "string"}
                                  }
                                }
                              },
                              "images": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "required": ["id", "src"],
                                  "properties": {
                                    "id": {"type": "string"},
                                    "src": {"type": "string"},
                                    "alt": {"type": "string"}
                                  }
                                }
                              },
                              "table": {
                                "type": "object",
                                "properties": {
                                  "headers": {"type": "array", "items": {"type": "string"}},
                                  "rows": {"type": "array", "items": {"type": "array", "items": {"type": "object"}}}
                                }
                              },
                              "formTable": {
                                "type": "object",
                                "properties": {
                                  "headers": {"type": "array", "items": {"type": "string"}},
                                  "rows": {"type": "array", "items": {"type": "array", "items": {
                                    "type": "object",
                                    "properties": {
                                      "value": {"type": "string"},
                                      "colspan": {"type": "integer"},
                                      "hasInput": {"type": "boolean"},
                                      "inputFor": {
                                        "oneOf": [
                                          {"type": "integer"},
                                          {"type": "array", "items": {"type": "integer"}}
                                        ]
                                      }
                                    }
                                  }}}
                                }
                              },
                              "gapText": {"type": "string", "description": "Full text with ___ marking gap positions"}
                            }
                          }
                        },
                        "wordList": {
                          "type": "object",
                          "description": "For gap-fill/summary completion types that provide a word bank",
                          "properties": {
                            "words": {"type": "array", "items": {"type": "string"}},
                            "note": {"type": "string"}
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "answerKeys": {
      "type": "object",
      "required": ["reading"],
      "properties": {
        "reading": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "passage-id -> {questionNumber: answer}"
          }
        }
      }
    }
  }
}
